@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Контекстная диаграмма C1 — Альтернативное решение

Person(operator, "Дежурный оператор", "На ферме")
Person(agronom, "Агроном / Ветеринар", "На ферме")
Person(analyst, "Аналитик", "В головном офисе")

System_Boundary(farm, "Свиноводческая ферма") {
    System(gateway, "IoT-шлюз", "Только ретранслирует данные, сам не анализирует, не хранит, не оповещает")
    System(web_ui, "Локальный веб-портал", "UI для оператора и агронома, зависит от интернета")
    System(cameras, "Видеокамеры", "RTSP-видеопоток")
    System(sensors, "Датчики", "Уровень корма, качество воды, вес")
    System(feeders, "Контроллеры кормушек/поилок", "Приём команд на досыпку")
}

System_Ext(office, "Головной офис", "Вся обработка: видеоаналитика, нейросети, команды на кормушки, хранение, API для добавления метрик, централизованная авторизация OAuth2/JWT")

Rel(cameras, gateway, "RTSP-видеопоток", "Локальная сеть")
Rel(sensors, gateway, "MQTT / Modbus", "Локальная сеть")
Rel(gateway, feeders, "Команды (только через офис)", "Локальная сеть")
Rel(web_ui, gateway, "REST / WebSocket", "Локальная сеть")
Rel(gateway, office, "Весь видеопоток + показания датчиков + запросы с веб-портала", "Интернет (постоянно)")
Rel(office, gateway, "Команды на кормушки + оповещения на веб-портал", "Интернет (постоянно)")
Rel(office, analyst, "Формирование отчётов", "Корпоративная сеть")
Rel(agronom, office, "Добавление пользовательских метрик", "Интернет (постоянно)")
Rel(operator, web_ui, "Локальная сеть")
Rel(agronom, web_ui, "Локальная сеть")

@enduml