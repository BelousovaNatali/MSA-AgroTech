@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Контекстная диаграмма C1 — Основное решение

Person(operator, "Дежурный оператор", "На ферме. Локальная авторизация (логин/пароль)")
Person(agronom, "Агроном / Ветеринар", "На ферме. Локальная авторизация (логин/пароль)")
Person(analyst, "Аналитик", "В головном офисе. OAuth2 / JWT")
Person(manager, "Менеджер / Администратор", "В головном офисе. OAuth2 / JWT")

System_Boundary(farm, "Свиноводческая ферма") {
    System(central_server, "Локальный диспетчер", "Видеоаналитика, управление кормушками, сбор датчиков, локальное оповещение, синхронизация, хранение учётных записей пользователей фермы, приём пользовательских метрик")
    System(cameras, "Видеокамеры", "RTSP-видеопоток")
    System(sensors, "Датчики", "Уровень корма, качество воды, вес")
    System(feeders, "Контроллеры кормушек/поилок", "Приём команд на досыпку")
    System(web_ui, "Локальный веб-портал", "UI для оператора и агронома. Просмотр тревог и метрик, ручное управление, добавление пользовательских метрик. Работает без интернета.")
}

System_Ext(office, "Головной офис", "Центральные сервисы, хранилища данных (Kafka, ClickHouse, MinIO), BI (Power BI), ERP (1С). Централизованная авторизация OAuth2/JWT")

Rel(operator, web_ui, "Логин/пароль, просмотр тревог, управление кормушками", "Локальная сеть")
Rel(agronom, web_ui, "Логин/пароль, просмотр метрик, добавление метрик", "Локальная сеть")
Rel(analyst, office, "OAuth2 / JWT, формирование отчётов", "Корпоративная сеть")
Rel(manager, office, "OAuth2 / JWT, управление конфигурациями", "Корпоративная сеть")
Rel(cameras, central_server, "RTSP-видеопоток", "Локальная сеть")
Rel(sensors, central_server, "MQTT / Modbus (показания)", "Локальная сеть")
Rel(central_server, feeders, "Modbus (команды на досыпку)", "Локальная сеть")
Rel(web_ui, central_server, "REST / WebSocket (запросы, уведомления, метрики)", "Локальная сеть")
Rel(central_server, office, "Синхронизация метрик, событий, пользовательских метрик, видео (раз в 10 мин)", "Интернет (Kafka Protocol / gRPC)")

@enduml