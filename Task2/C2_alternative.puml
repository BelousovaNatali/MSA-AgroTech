@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Контейнерная диаграмма C2 — Альтернативное решение (с брокером RabbitMQ)

Person(operator, "Дежурный оператор", "На ферме")
Person(agronom, "Агроном / Ветеринар", "На ферме")
Person(analyst, "Аналитик", "В головном офисе")

System_Boundary(farm, "Свиноводческая ферма") {
    Container(web_portal, "Веб-портал", "React + Nginx", "UI для оператора и агронома")
    Container(data_collector, "Сервис сбора данных", "Python + FastAPI", "Сбор показаний датчиков, публикация в RabbitMQ")
    Container(video_analytics, "Сервис видеоаналитики", "Python + FastAPI", "RTSP → вызов нейросети, публикация тревог в RabbitMQ")
    Container(feeder_controller, "Сервис управления кормушками", "Python + FastAPI + pymodbus", "Подписка на RabbitMQ, отправка Modbus")
    Container(alerting, "Сервис оповещений", "Python + WebSockets", "Подписка на RabbitMQ, push на веб-портал")
    Container(sync_agent, "Сервис синхронизации", "Python + aiokafka", "Подписка на RabbitMQ, отправка в Kafka")
    Container(message_bus, "Брокер сообщений", "RabbitMQ", "Центральная шина данных. Хранит очереди на диске (буфер при потере связи)")
    Container(local_auth, "Сервис аутентификации", "Python + PyJWT", "Локальные пользователи, выдача JWT")
    ContainerDb(local_auth_db, "БД пользователей", "SQLite", "Логины, хеши, роли")
    Container(cameras, "Видеокамеры", "RTSP", "Видеопоток")
    Container(feeders, "Контроллеры кормушек", "Modbus", "Исполнительные устройства")
    Container(sensors, "Датчики", "Modbus / MQTT", "Уровень корма, вода, вес")
}

System_Ext(partner_nn, "Нейросеть партнёра", "Детекция драк, болезней, подсчёт голов")

System_Boundary(office, "Головной офис") {
    Container(kafka, "Apache Kafka", "Kafka", "Приём данных с ферм")
    Container(clickhouse, "ClickHouse", "ClickHouse", "Хранилище метрик")
    Container(powerbi, "Power BI", "Power BI", "BI-отчёты")
    Container(erp, "ERP 1С", "1С", "Бизнес-данные")
}

Rel(cameras, video_analytics, "RTSP")
Rel(video_analytics, partner_nn, "gRPC")
Rel(sensors, data_collector, "Modbus / MQTT")
Rel(feeder_controller, feeders, "Modbus")

Rel(data_collector, message_bus, "AMQP (показания)")
Rel(video_analytics, message_bus, "AMQP (тревоги)")

Rel(message_bus, feeder_controller, "AMQP (команды досыпки)")
Rel(message_bus, alerting, "AMQP (тревоги)")
Rel(message_bus, sync_agent, "AMQP (все события)")

Rel(alerting, web_portal, "WebSocket (push)")
Rel(web_portal, data_collector, "HTTP (ручное управление)")

Rel(web_portal, local_auth, "JWT")
Rel(local_auth, local_auth_db, "SQL")

Rel(sync_agent, kafka, "Kafka Protocol")

Rel(kafka, clickhouse, "Kafka Connect")
Rel(clickhouse, powerbi, "ODBC")
Rel(clickhouse, erp, "REST")

Rel(operator, web_portal, "Мониторит/управляет")
Rel(agronom, web_portal, "Мониторит")
Rel(analyst, powerbi, "Корпоративная сеть")

@enduml